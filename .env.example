# ==============================================================================
# Vasudha Polymer VTMS - Environment Configuration Template (.env.example)
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# MongoDB Configuration
# Local: mongodb://localhost:27017/vasudha_seller
# Atlas / Cloud: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vasudha_seller?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/vasudha_seller"

# Server Configuration
PORT=5000
JWT_SECRET="change_this_to_a_secure_random_secret_in_production"
JWT_EXPIRES_IN="24h"

# Application Environment & Debug Settings
# APP_ENV: 'development' (local) or 'production' (Railway / cloud)
# APP_DEBUG: 'true' (verbose connection logs) or 'false' (production clean logs)
APP_ENV=development
APP_DEBUG=true

# Client & API Configuration
# Local: http://localhost:5000/api/v1
# Production: https://<your-railway-app-domain>.up.railway.app/api/v1
VITE_API_URL="http://localhost:5000/api/v1"

# Company Branding & Invoice Receipt Information
VITE_COMPANY_NAME="Vasudha Polymer"
VITE_COMPANY_GST="07AAAAA0000A1Z5"
VITE_COMPANY_PHONE="+91 98765 43210"
VITE_COMPANY_ADDRESS="Plot 42, Industrial Zone, New Delhi - 110020"

# Dashboard Banner & Hero Configuration
VITE_DASHBOARD_BADGE="Vasudha Polymer Admin Hub"
VITE_DASHBOARD_TITLE_LINE1="Seller & Transaction"
VITE_DASHBOARD_TITLE_LINE2="Command Center"
VITE_DASHBOARD_SUBTITLE="Real-time vendor deliveries, financial settlements, and server-computed dues across all accounts."
