# ==============================================================================
# Vasudha Polymer VTMS - Git Ignore (.gitignore)
# ==============================================================================

# Environment files (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example

# Node Dependencies
node_modules/
*/node_modules/

# Build and Production Artifacts
dist/
build/
out/
*/dist/
*/build/

# Logs and runtime debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and IDE directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Testing & Coverage
coverage/
.nyc_output/

# Mobile / Expo builds and caches
.expo/
*/.expo/
.expo-shared/
*/.expo-shared/
web-build/
*/web-build/
.metro-health-check*
*/.metro-health-check*

# Temporary and Cache files
.cache/
.parcel-cache/
.turbo/
.tmp/
tmp/

# Separate Mobile App Repository (Maintained in independent Git repo)
/app/
app/
